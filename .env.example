# Copy this file to .env for local development. Never commit the real .env.

# Postgres connection string (Neon gives you one; for local Postgres use
# something like postgres://postgres:yourpass@localhost:5432/dutylog)
DATABASE_URL=

# Set to false only for a local Postgres without SSL. Leave unset/true for Neon.
PGSSL=true

# Any long random string — used to sign session cookies.
SESSION_SECRET=

# Generate with: npm run hash "your password"
APP_PASSWORD_HASH=

NODE_ENV=development
PORT=3000
